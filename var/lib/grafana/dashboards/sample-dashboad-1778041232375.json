          "rawSql": "with latest_slow_run as (\nselect slow_run_started_at\nfrom nginx_access_runs\nwhere slow_run_started_at between $__fromTime and $__toTime\norder by slow_run_started_at desc\nlimit 1\n)\nselect\nuri\n, method\n, count as \"合計\"\n, c_2xx as \"2xx\"\n, c_3xx as \"3xx\"\n, c_4xx as \"4xx\"\n, c_5xx as \"5xx\"\n, sum as \"合計時間\"\n, min as \"最短時間\"\n, max as \"最長時間\"\n, avg as \"平均時間\"\n, p90 as \"p90時間\"\nfrom nginx_access_runs\nwhere slow_run_started_at = (select slow_run_started_at from latest_slow_run)\norder by sum desc\n;",
